PORT = 5000
DATABASE_URL="YOURDATABASEURL"

# Server-only Clerk secret key (sk_test_... / sk_live_...). Required: used both
# for token verification (JWKS fallback) and the Clerk Backend API.
CLERK_SECRET_KEY="sk_test_YOURSECRETKEY"
# Optional PEM public key (from Clerk dashboard: API Keys > Public key > PEM).
# When set, tokens are verified locally without network calls; key rotation is
# then manual. Leave empty to fall back to JWKS (auto rotation, ~5 min cache).
CLERK_JWT_KEY=""
# Comma-separated list of acceptable `azp` values (frontend origins). Strongly
# recommended — per Clerk's docs, omitting it can open replay/CSRF vectors.
CLERK_AUTHORIZED_PARTIES="http://localhost:5173"
# Signing secret (whsec_...) of the Clerk webhook endpoint registered in the
# dashboard. Leave empty in environments that don't receive webhooks.
CLERK_WEBHOOK_SECRET=""

NODE_ENV="development"
R2_ACCESS_KEY_ID="YOURACCESSKEYID"
R2_SECRET_ACCESS_KEY="YOURSECRETACCESSKEY"
R2_BUCKET_NAME="listing-images"
R2_PUBLIC_URL="https://r2.dev"
SMTP_HOST="smtpHOST"
SMTP_PORT="465"
SMTP_USER="donotreply@example.com"
SMTP_PASS="YOURPASSWORD"
EMAIL_FROM="EXAMPLE <donotreply@example.com>"
