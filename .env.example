PORT = 5000
DATABASE_URL="YOURDATABASEURL"

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL="https://YOURPROJECTREF.supabase.co"
# Only needed for legacy projects still using the symmetric HS256 JWT secret.
# Leave empty for projects using asymmetric JWT signing keys (JWKS is used).
SUPABASE_JWT_SECRET=""
# Server-only key for Supabase Admin API (auth user deletion/ban propagation).
SUPABASE_SERVICE_ROLE_KEY="YOURSERVICE ROLE KEY"

NODE_ENV="development"
R2_ACCESS_KEY_ID="YOURACCESSKEYID"
R2_SECRET_ACCESS_KEY="YOURSECRETACCESSKEY"
R2_BUCKET_NAME="listing-images"
R2_PUBLIC_URL="https://r2.dev"
SMTP_HOST="smtpHOST"
SMTP_PORT="465"
SMTP_USER="donotreply@example.com"
SMTP_PASS="YOURPASSWORD"
EMAIL_FROM="EXAMPLE <donotreply@example.com>"
GEOAPIFY_API_KEY=YOURAPIKEY
